# Copy to .env.local for local `vercel dev`, and set the same keys in the
# Vercel project's Environment Variables for production/preview.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives Discovery Call submissions.
TO_EMAIL=emma.auradigital@gmail.com

# Optional. Defaults to Resend's shared test sender, which works with no
# domain setup. Once a sending domain is verified in Resend, point this at
# it (e.g. "Aura Digital <hello@auradigital.studio>") for better deliverability.
FROM_EMAIL=
