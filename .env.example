# Copy to .env.local for local `vercel dev`, and set the same keys in the
# Vercel project's Environment Variables for production/preview.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives Discovery Call submissions.
TO_EMAIL=emma.auradigital@gmail.com

# Optional. Defaults to Resend's shared test sender, which works with no
# domain setup. Once a sending domain is verified in Resend, point this at
# it (e.g. "Aura Digital <hello@auradigital.studio>") for better deliverability.
FROM_EMAIL=

# Supabase project — https://supabase.com/dashboard → Settings → API.
# Powers the /manager area (auth + editable content) and Discovery Call
# submission storage. The VITE_ prefix means these two are bundled into the
# client — that's expected, the anon key is meant to be public (Row Level
# Security is what actually restricts writes).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret. Server-side only (used by api/discovery.js to insert submissions
# without going through RLS). Never prefix this with VITE_ — that would ship
# it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
